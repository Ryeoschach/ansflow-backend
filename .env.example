# ==============================================================================
# AnsFlow 生产环境环境变量模板 (.env)
# 使用说明: 拷贝此文件为 .env，并修改其中的敏感信息
# ==============================================================================

# --- 1. 核心 Django 设置 ---
# 生产环境必须设置为 False
DEBUG=False

# 建议生成一个新的 50 位随机字符串
SECRET_KEY=django-insecure-prod-$(openssl rand -base64 32)

# 允许访问的域名，多个用逗号分隔。例如: ansflow.example.com,1.2.3.4
ALLOWED_HOSTS=localhost,127.0.0.1

# 后端接口访问地址（用于构建静态资源/头像的完整 URL）
# 生产环境请修改为实际域名，如: https://api.ansflow.com
BACKEND_URL=http://localhost:8000

# 设置为 production 使用生产配置
DJANGO_SETTINGS_MODULE=config.settings.production


# --- 2. 数据库配置 (对接 Docker Compose 中的 ansflow-db) ---
# 格式: postgres://用户:密码@主机:端口/数据库名
DATABASE_URL=postgres://ansflow_user:ansflow_password@ansflow-db:5432/ansflow


# --- 3. Redis 与 Celery 配置 (对接 Docker Compose 中的 ansflow-redis) ---
# 用于 Django 缓存和 Session
REDIS_URL=redis://ansflow-redis:6379/0

# 用于 Celery 任务分发 (使用 db 6)
CELERY_BROKER_URL=redis://ansflow-redis:6379/6


# --- 4. 安全与 SSL (如果前端有 Nginx 代理并开启了 HTTPS，建议开启) ---
# 是否强制重定向到 HTTPS
SECURE_SSL_REDIRECT=False


# --- 5. 消息通知插件 (可选) ---
# 飞书群机器人 Webhook 地址
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxx

# 钉钉群机器人 Webhook 地址
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxxxxx

# 前端访问地址（用于发送通知中的跳转链接）
FRONTEND_URL=http://localhost:8000


# --- 6. 日志设置 ---
# 日志级别: DEBUG, INFO, WARNING, ERROR
ANSFLOW_LOG_LEVEL=INFO
# 是否输出 JSON 格式日志 (生产环境建议开启，方便 ELK 采集)
ANSFLOW_LOG_JSON=true


# --- 7. 自动创建超级管理员 (仅在首次启动时生效) ---
# Django 会自动读取这些变量来执行 createsuperuser
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=ansflow_admin_password
DJANGO_SUPERUSER_EMAIL=admin@example.com
