# ==============================================================================
# AnsFlow 生产环境环境变量模板 (.env)
# 使用说明: 拷贝此文件为 .env，并修改其中的敏感信息
# ==============================================================================

# --- 1. 核心 Django 设置 ---
# 生产环境必须设置为 False
DEBUG=False

# 建议生成一个新的 50 位随机字符串
SECRET_KEY=django-insecure-prod-replace-me-with-random-string

# 允许访问的域名，多个用逗号分隔。例如: ansflow.example.com,1.2.3.4
ALLOWED_HOSTS=localhost,127.0.0.1,ansflow.cyfee.com

# 后端接口访问地址（用于构建静态资源/头像的完整 URL）
# 生产环境请修改为实际域名，如: https://api.ansflow.com
BACKEND_URL=http://localhost:8000

# 前端访问地址（用于发送通知中的跳转链接、跨域白名单等）
FRONTEND_URL=http://localhost:3000

# 设置为 production 使用生产配置
DJANGO_SETTINGS_MODULE=config.settings.production


# --- 2. 数据库配置 ---
# 开发环境 (本地直接运行建议使用 SQLite，无需配置数据库服务):
# DATABASE_URL=sqlite:///db.sqlite3

# PostgreSQL (生产环境/Docker 推荐):
# 格式: postgres://用户名:密码@主机地址:端口/数据库名
# 注意: 如果使用 Docker Compose，主机地址应填容器名 (如 ansflow-db)
DATABASE_URL=postgres://ansflow_user:ansflow_password@ansflow-db:5432/ansflow

# MySQL (可选):
# 格式: mysql://用户名:密码@主机地址:端口/数据库名
# DATABASE_URL=mysql://ansflow_user:ansflow_password@ansflow-db:3306/ansflow


# --- 3. Redis 与 Celery 配置 (对接 Docker Compose 中的 ansflow-redis) ---
# 用于 Django 缓存和 Session
REDIS_URL=redis://ansflow-redis:6379/0

# 用于 Celery 任务分发 (使用 db 6)
CELERY_BROKER_URL=redis://ansflow-redis:6379/6


# --- 4. AI 与 RAG (向量检索) 配置 ---
# LLM API 密钥 (如 DeepSeek, OpenAI 等)
LLM_API_KEY=sk-your-api-key-here
LLM_API_BASE=https://api.deepseek.com

# 向量库存储类型: chroma (本地文件) 或 pgvector (PostgreSQL 插件)
# 生产环境配合 Docker Compose 建议使用 pgvector
VECTOR_STORE_TYPE=pgvector

# 向量模型本地缓存目录 (默认为 /app/.model_cache)
# MODEL_CACHE_DIR=/app/.model_cache


# --- 5. 跨域与安全配置 ---
# 允许跨域的域名，逗号分隔
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://ansflow.cyfee.com
CSRF_TRUSTED_ORIGINS=http://localhost:3000,https://api.cyfee.com

# 是否强制重定向到 HTTPS (开发环境设为 False)
SECURE_SSL_REDIRECT=False


# --- 6. 第三方登录 (OAuth) ---
# GitHub OAuth App
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret


# --- 7. LDAP 身份认证 ---
LDAP_SERVER=ldap://localhost:389
LDAP_BASE_DN=dc=cyfee,dc=com
LDAP_USER_DN_TEMPLATE=uid={username},ou=users,dc=cyfee,dc=com
LDAP_MANAGER_DN=cn=admin,dc=cyfee,dc=com
LDAP_MANAGER_PASSWORD=your-ldap-password


# --- 8. 消息通知插件 (可选) ---
# 飞书群机器人 Webhook 地址
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxx

# 钉钉群机器人 Webhook 地址
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxxxxx


# --- 9. 日志设置 ---
# 日志级别: DEBUG, INFO, WARNING, ERROR
ANSFLOW_LOG_LEVEL=INFO
# 是否输出 JSON 格式日志 (生产环境建议开启，方便 ELK 采集)
ANSFLOW_LOG_JSON=true


# --- 11. 网络代理配置 (可选，解决国内环境下载包慢或 API 访问失败) ---
# HTTP_PROXY=http://192.168.1.100:7890
# HTTPS_PROXY=http://192.168.1.100:7890
# NO_PROXY=localhost,127.0.0.1,ansflow-db,ansflow-redis,ansflow-api

# --- 12. 自动创建超级管理员 (仅在首次启动时生效) ---
# Django 会自动读取这些变量来执行 createsuperuser
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=ansflow_admin_password
DJANGO_SUPERUSER_EMAIL=admin@example.com
